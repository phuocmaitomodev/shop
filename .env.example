# Application
APP_ENV=development
APP_SECRET_KEY=change-me-for-local-development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
AUTH_SESSION_TTL_DAYS=7
AUTH_COOKIE_NAME=shop_session
AUTH_COOKIE_SECURE=false
PASSWORD_RESET_TTL_MINUTES=30
AUTH_RATE_LIMIT_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_KEYS=10000
FORGOT_RESPONSE_FLOOR_MS=250
API_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# PostgreSQL / pgvector
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://shop:change-me-for-local-development@db:5432/shop

# Reserved for later RAG tasks; no real key or hard-coded model is provided here.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=replace-with-selected-gemini-model
GEMINI_EMBEDDING_MODEL=replace-with-selected-embedding-model
EMBEDDING_DIMENSION=replace-with-selected-model-dimension

# Reserved for later commerce tasks.
SHIPPING_FLAT_FEE=30000
FREE_SHIPPING_THRESHOLD=500000
MEDIA_ROOT=/app/media
PUBLIC_MEDIA_BASE_URL=/media
