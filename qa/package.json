{
  "name": "shop-qa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:smoke:chromium": "playwright test --grep @smoke --project=chromium-desktop --project=chromium-mobile",
    "test:mvp": "playwright test --grep @mvp --project=chromium-desktop --project=chromium-mobile",
    "test:return-policy": "playwright test --grep @return-policy --project=chromium-desktop --project=chromium-mobile",
    "test:return-policy:corpus": "node scripts/return-policy-corpus.mjs",
    "test:commerce-contract": "node scripts/validate-commerce-expansion.mjs",
    "test:account-artifacts": "node scripts/verify-account-artifacts.mjs",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3"
  }
}
